# Required for Telegram; both platforms share the Telegram support forum
TG_BOT_TOKEN=YOUR_TELEGRAM_TOKEN
TG_GROUP_ID=-1001234567890
TG_WEBHOOK_SECRET=CHOOSE_A_LONG_RANDOM_SECRET
ADMIN_IDS=123456789

# Optional until MAX bot is ready
MAX_BOT_TOKEN=
MAX_WEBHOOK_SECRET=
MAX_API_BASE=https://platform-api2.max.ru

# Public HTTPS URL, no trailing slash
PUBLIC_BASE_URL=https://support.example.org
DATABASE_URL=postgresql+psycopg://support:CHANGE_ME@127.0.0.1:5432/support
STORAGE_DIR=./data/materials

# Your branding; greeting may later be changed via /admin
PROJECT_NAME=Support Desk
UI_LANGUAGE=ru
